<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InfoPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="LibUsbDotNet" Version="2.2.75" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
    <ProjectReference Include="..\InfoPanel.Devices\InfoPanel.Devices.csproj" />
    <ProjectReference Include="..\InfoPanel.Platform\InfoPanel.Platform.csproj" />
    <ProjectReference Include="..\InfoPanel.Rendering\InfoPanel.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logical names resolve to InfoPanel.Resources.Overlays.<file>.png, as LoadMaskBitmap expects -->
    <EmbeddedResource Include="Resources\Overlays\*.png" />
  </ItemGroup>

</Project>
