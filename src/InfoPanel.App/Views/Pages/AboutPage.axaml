<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="InfoPanel.Views.Pages.AboutPage">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="About" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Spacing="8">
                <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="InfoPanel for Linux, rebuilt on Avalonia. Based on InfoPanel by habibrehmansg."
                           FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open data folder" Click="OpenDataFolder_Click" />
                    <Button Content="Open log folder" Click="OpenLogFolder_Click" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" />
                        <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Border x:Name="UpdateBox" IsVisible="False" CornerRadius="6" Padding="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="UpdateTitleText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="What changed:" FontSize="12" FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="260">
                                <TextBlock x:Name="UpdateNotesText" FontSize="11" Opacity="0.85" TextWrapping="Wrap" />
                            </ScrollViewer>
                            <Button x:Name="UpdateDownloadButton" Content="Open download page" Click="OpenLink_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <WrapPanel>
                    <Button Content="User guide" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://github.com/emaspa/InfoPanel-linux/blob/main/docs/USER-GUIDE.md" />
                    <Button Content="Website" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://infopanel.net/" />
                    <Button Content="GitHub" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://github.com/emaspa/InfoPanel-linux" />
                    <Button Content="Discord" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://discord.gg/cQnjdMC7Qc" />
                    <Button Content="Reddit" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://www.reddit.com/r/InfoPanel/" />
                    <Button Content="Support development ♥" Margin="0,0,8,8" Click="OpenLink_Click" Tag="https://buymeacoffee.com/emaspa" />
                </WrapPanel>
                <Expander Header="Release notes" FontSize="12">
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <TextBlock Text="v0.1.4 alpha: panel stream cadence fix" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Fixes a v0.1.3 regression: some panel firmwares (Trofeo bulk models in particular) treat a slow stream as stopped and fall back to their boot logo when frames only arrived once a second on static content. Unchanged frames are now resent at the full frame rate from the cached payload, so wire behavior matches pre-0.1.3 builds while the expensive rendering and encoding work stays skipped." />
                        <TextBlock Text="v0.1.3 alpha: performance" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Large CPU and memory reductions: profiles render once per tick and are shared by all panels and the web server, frames whose pixels have not changed skip the resize, encode and USB send entirely (a heartbeat frame keeps panels warm), text layouts are cached instead of re-shaped every frame, and long GIF animations no longer keep every frame in memory. On a bench with three panels streaming, CPU dropped to roughly a quarter of the previous build; mostly static dashboards idle far lower." />
                        <TextBlock Text="v0.1.2 alpha: designer polish" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Three reported paper cuts: the color picker no longer closes the moment a slider is touched (the inspector rebuilt itself on every edit, killing the open flyout and slider drags), the layers panel lists the front-most item at the top so up and down move items the way you expect, and Home screen profile cards show friendly device names for all panel families instead of internal model identifiers." />
                        <TextBlock Text="v0.1.1 alpha: designer stability" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Fixes native crashes while editing a profile with panels streaming: text rendering no longer races on shared fonts across render threads, GPU textures are released on the correct thread (editing or animating images could crash the app), gauge image lists are snapshotted during edits, and a failing display item now skips a frame instead of taking the app down." />
                        <TextBlock Text="v0.1.0 alpha: Jonsbo AIO displays" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="New Jonsbo panel family, both models verified on real hardware: the DS916 (9.16 inch, 462x1920, HLVMAX serial with raw JPEG frames) and the DS339 (376x960, MacroSilicon MS9132 with HID control and bulk UYVY frames). The DS339 shares its USB identity with the VMAX 4.6 inch, so the device scan reads the panel EDID to tell them apart. The VMAX path gains the same Linux protocol fixes (direct hidraw feature reports, UYVY pixel format)." />
                        <TextBlock Text="v0.0.9 alpha: panel options everywhere" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Every panel family gets the collapsible Panel options section with brightness, per-device target FPS, and JPEG quality where the protocol uses JPEG. Device cards show the native resolution for all models, BeadaPanel cards show friendly model names, and the Thermaltake 6 inch is verified on real hardware (24 fps at 17 ms)." />
                        <TextBlock Text="v0.0.8 alpha: Trofeo HID panel family" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="The Trofeo HID protocol family (6.86 inch and about 15 sibling models) now works: udev rules cover their hidraw nodes, frames stream through the HID interface (the libusb style upgrade cannot work on Linux where the kernel driver owns it), and the device scan no longer aborts when an unreadable HID device is present. Verified on a Trofeo Vision 6.86 inch at 24 fps." />
                        <TextBlock Text="v0.0.7 alpha: stability with multiple panels" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Fixed a native crash that killed the app seconds after start when a wedged panel failed its init handshake. Two identical Trofeo panels now reconnect cleanly after replug (each task claims its own device instead of both fighting over one), and pressing Scan no longer renames an identified 11.3 inch or 9.16 v2 back to the base model." />
                        <TextBlock Text="v0.0.6 alpha: serial panel speed, 11.3 inch identification" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Serial Turing panels (Turzx 5 inch and friends) batch their protocol writes, lifting frame rates toward Windows levels. Trofeo 11.3 inch and 9.16 inch v2 keep their runtime identification: the device card updates live and the model persists across restarts. Disabled devices say disabled instead of idle." />
                        <TextBlock Text="v0.0.5 alpha: Turing USB panels" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="USB Turing/TURZX panels stream reliably: the protocol now consumes the device response after every command (frames stalled at zero bytes before), and frames are sent as JPEG like the Windows build, roughly tripling the frame rate. Turing devices get a Panel options section with brightness, per-device target FPS and JPEG quality, portrait strips default to 90 degrees at scan, and cards show the native resolution. Shipped stack traces no longer contain build machine paths." />
                        <TextBlock Text="v0.0.4 alpha: serial panel detection" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Serial Turing/Turzx and JL panels are now detected: sysfs symlink resolution in the port scan was broken, so no serial panel was ever found. Scanning no longer resets an identified ChiZhu panel (like the Phantom Spirit 120 Vision EVO) to Unknown. Start minimized works. Launching InfoPanel while it is already running brings the window to the front, and minimizing with close-to-tray enabled no longer crashes." />
                        <TextBlock Text="v0.0.3 alpha: shutdown and serial panel fixes" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Logout and restart no longer stall while InfoPanel is running: the app exits cleanly when the session ends and close-to-tray no longer intercepts OS shutdown. udev rules now cover the serial tty nodes of Turing/Turzx panels, so they work without dialout group membership. Fixed the tray Exit occasionally leaving the process behind." />
                        <TextBlock Text="v0.0.2 alpha: first published build" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Self-contained tarball on GitHub Releases with installer, udev rules and SMART sensor timer. Update checking with release notes and desktop notification. Plugin-rendered images as live display items (Audio Spectrum bundled), program-specific profiles via foreground app detection, per-profile autosave backup restore, refreshing URL images, Thermaltake/ASRock, JL/Hongtai, VMAX and Lian Li panel support, profile and stopwatch hotkeys, plugin configuration UI, and the full 1.4.x designer feature set (glow, gauge mirror, thousands separator, guide items)." />
                        <TextBlock Text="v0.0.1 alpha: ground-up Linux rebuild" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="New Avalonia 12 UI with a direct-manipulation designer (zoom/pan canvas, undo/redo, layers, live sensor tree). Latest Thermalright/TRCC device support from the Windows fork with USB replug self-healing. Video backgrounds via ffmpeg. Web server, XDG autostart, profile import/export. Profiles remain fully compatible with v1.4 and InfoPanel for Windows." />
                    </StackPanel>
                </Expander>
                <Expander Header="Contributors" FontSize="12">
                    <StackPanel x:Name="ContributorsList" Spacing="4" Margin="0,8,0,0" />
                </Expander>
                <Expander Header="Third-party licenses" FontSize="12">
                    <StackPanel x:Name="LicensesList" Spacing="4" Margin="0,8,0,0" />
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
