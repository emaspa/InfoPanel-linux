<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        x:Class="InfoPanel.Views.MainWindow"
        Title="InfoPanel Linux"
        Icon="avares://infopanel/Assets/favicon.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600">

    <DockPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" x:Name="LogsToggle" Content="Logs" FontSize="12"
                              Padding="8,2" Click="LogsToggle_Click" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Starting…" />
            </DockPanel>
        </Border>

        <!-- Logs drawer -->
        <Border DockPanel.Dock="Bottom" x:Name="LogsDrawer" IsVisible="False" Height="220"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="12,6">
                    <TextBlock Text="Session log" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Copy" FontSize="12" Padding="8,2" Click="LogsCopy_Click" />
                    <Button Content="Clear" FontSize="12" Padding="8,2" Click="LogsClear_Click" />
                    <Button Content="Open log folder" FontSize="12" Padding="8,2" Click="LogsFolder_Click" />
                </StackPanel>
                <ListBox x:Name="LogsList" FontFamily="monospace" FontSize="11" Margin="8,0,8,8" />
            </DockPanel>
        </Border>

        <ui:FANavigationView x:Name="NavView"
                           PaneDisplayMode="LeftCompact"
                           IsSettingsVisible="True"
                           IsBackButtonVisible="False"
                           OpenPaneLength="220"
                           SelectionChanged="NavView_SelectionChanged">
            <ui:FANavigationView.MenuItems>
                <ui:FANavigationViewItem Content="Dashboard" Tag="dashboard" IconSource="Home" />
                <ui:FANavigationViewItem Content="Designer" Tag="designer" IconSource="Edit" />
                <ui:FANavigationViewItem Content="Devices" Tag="devices">
                    <ui:FANavigationViewItem.IconSource>
                        <!-- Leading/trailing zero-area segments pad the geometry bounds to the full
                             24x24 box so the icon scales with the same margins as the font glyphs -->
                        <ui:FAPathIconSource Data="M0,1 L0.01,1.01 M23.99,22.99 L24,23 M3.75,4 H20.25 C21.216,4 22,4.784 22,5.75 V14.75 C22,15.716 21.216,16.5 20.25,16.5 H3.75 C2.784,16.5 2,15.716 2,14.75 V5.75 C2,4.784 2.784,4 3.75,4 Z M3.5,5.75 V14.75 C3.5,14.888 3.612,15 3.75,15 H20.25 C20.388,15 20.5,14.888 20.5,14.75 V5.75 C20.5,5.612 20.388,5.5 20.25,5.5 H3.75 C3.612,5.5 3.5,5.612 3.5,5.75 Z M11.25,16.5 H12.75 V18.5 H16.75 C17.164,18.5 17.5,18.836 17.5,19.25 C17.5,19.664 17.164,20 16.75,20 H7.25 C6.836,20 6.5,19.664 6.5,19.25 C6.5,18.836 6.836,18.5 7.25,18.5 H11.25 Z" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Sensors" Tag="sensors">
                    <ui:FANavigationViewItem.IconSource>
                        <ui:FAPathIconSource Data="M0,1 L0.01,1.01 M23.99,22.99 L24,23 M3,14.5 A9,9 0 0 1 21,14.5 L19.5,14.5 A7.5,7.5 0 0 0 4.5,14.5 Z M10.9,12.48 L7.66,9.24 L6.74,10.16 L9.98,13.4 Z M10.4,14.5 A1.6,1.6 0 1 0 13.6,14.5 A1.6,1.6 0 1 0 10.4,14.5 Z" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
                <ui:FANavigationViewItem Content="Plugins" Tag="plugins" IconSource="AllApps" />
            </ui:FANavigationView.MenuItems>

            <ui:FANavigationView.FooterMenuItems>
                <ui:FANavigationViewItem Content="About" Tag="about">
                    <ui:FANavigationViewItem.IconSource>
                        <!-- "i" info circle; FASymbol has no Info glyph. Zero-area lead/tail
                             segments pad the bounds like the other custom rail icons. -->
                        <ui:FAPathIconSource Data="M0,1 L0.01,1.01 M23.99,22.99 L24,23 M2,12 A10,10 0 1 0 22,12 A10,10 0 1 0 2,12 Z M3.5,12 A8.5,8.5 0 1 1 20.5,12 A8.5,8.5 0 1 1 3.5,12 Z M10.9,7.8 A1.1,1.1 0 1 0 13.1,7.8 A1.1,1.1 0 1 0 10.9,7.8 Z M11.25,10.5 H12.75 V16.5 H11.25 Z" />
                    </ui:FANavigationViewItem.IconSource>
                </ui:FANavigationViewItem>
            </ui:FANavigationView.FooterMenuItems>

            <ContentControl x:Name="PageHost" />
        </ui:FANavigationView>

    </DockPanel>

</Window>
