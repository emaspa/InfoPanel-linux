<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoPanel.ViewModels"
             x:Class="InfoPanel.Views.Pages.SensorsPage">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Sensors" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="SensorCount" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" PlaceholderText="Search sensors…"
                 Margin="0,0,0,8" TextChanged="Search_TextChanged" />
        <TreeView x:Name="Tree" Tapped="Tree_Tapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="vm:SensorTreeItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:SensorTreeItem" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,Auto" Opacity="{Binding DisplayOpacity}">
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1" Text="{Binding DisplayValue}"
                                   FontSize="12" Opacity="0.75" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>

</UserControl>
