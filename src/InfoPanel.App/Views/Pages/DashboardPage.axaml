<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoPanel.ViewModels"
             xmlns:utils="using:InfoPanel.Utils"
             x:Class="InfoPanel.Views.Pages.DashboardPage">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Import…" Click="Import_Click" />
                    <Button Content="+ New profile" Click="NewProfile_Click" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Your profiles and where they are shown."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="ProfileList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProfileCardViewModel">
                        <Border Width="300" Margin="0,0,16,16"
                                CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Border CornerRadius="8,8,0,0" ClipToBounds="True" Background="#111111" Height="160">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="8" />
                                </Border>
                                <StackPanel Margin="16,12,16,16" Spacing="8">
                                    <DockPanel>
                                        <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsActive}"
                                                      OnContent="" OffContent="" MinWidth="0" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Profile.Name}" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Duplicate" Click="Duplicate_Click" Tag="{Binding}" />
                                        <Button Content="Delete" Click="Delete_Click" Tag="{Binding}" />
                                        <Button Content="Export" Click="Export_Click" Tag="{Binding}" />
                                    </StackPanel>

                                    <Expander Header="Profile settings" FontSize="12">
                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                            <TextBox Text="{Binding Profile.Name, Mode=TwoWay}" PlaceholderText="Name" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <NumericUpDown Value="{Binding Profile.Width, Mode=TwoWay}" Minimum="1" Maximum="10000" Increment="1" FormatString="0" Width="120" />
                                                <TextBlock Text="×" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding Profile.Height, Mode=TwoWay}" Minimum="1" Maximum="10000" Increment="1" FormatString="0" Width="120" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Background" VerticalAlignment="Center" Width="90" FontSize="11" />
                                                <ColorPicker Color="{Binding Profile.BackgroundColor, Mode=TwoWay, Converter={x:Static utils:ColorHexConverter.Instance}}" Width="64" Height="26" />
                                                <TextBlock Text="Text" VerticalAlignment="Center" FontSize="11" />
                                                <ColorPicker Color="{Binding Profile.Color, Mode=TwoWay, Converter={x:Static utils:ColorHexConverter.Instance}}" Width="64" Height="26" />
                                            </StackPanel>
                                            <ComboBox ItemsSource="{x:Static utils:UiCatalog.FontFamilies}" SelectedItem="{Binding Profile.Font, Mode=TwoWay}" MaxDropDownHeight="360" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Font size" VerticalAlignment="Center" FontSize="11" />
                                                <NumericUpDown Value="{Binding Profile.FontSize, Mode=TwoWay}" Minimum="1" Maximum="200" Increment="1" FormatString="0" Width="110" />
                                                <TextBlock Text="Scale" VerticalAlignment="Center" FontSize="11" />
                                                <NumericUpDown Value="{Binding Profile.FontScale, Mode=TwoWay}" Minimum="0.1" Maximum="10" Increment="0.01" FormatString="0.00" Width="110" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Overlay X/Y" VerticalAlignment="Center" FontSize="11" />
                                                <NumericUpDown Value="{Binding Profile.WindowX, Mode=TwoWay}" Increment="1" FormatString="0" Width="110" />
                                                <NumericUpDown Value="{Binding Profile.WindowY, Mode=TwoWay}" Increment="1" FormatString="0" Width="110" />
                                                <Button Content="Reset" FontSize="11" Click="ResetPosition_Click" Tag="{Binding}" />
                                            </StackPanel>
                                            <WrapPanel>
                                                <CheckBox Content="Always on top" IsChecked="{Binding Profile.Topmost, Mode=TwoWay}" FontSize="12" Margin="0,0,8,0" />
                                                <CheckBox Content="Draggable" IsChecked="{Binding Profile.Drag, Mode=TwoWay}" FontSize="12" Margin="0,0,8,0" />
                                                <CheckBox Content="Resizable" IsChecked="{Binding Profile.Resize, Mode=TwoWay}" FontSize="12" Margin="0,0,8,0" />
                                                <CheckBox Content="Show FPS" IsChecked="{Binding Profile.ShowFps, Mode=TwoWay}" FontSize="12" Margin="0,0,8,0" />
                                            </WrapPanel>
                                            <Button Content="Save profile" FontSize="12" Click="SaveProfile_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

</UserControl>
