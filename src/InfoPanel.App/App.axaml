<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="InfoPanel.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <sty:FluentAvaloniaTheme CustomAccentColor="#14B8A6" />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://infopanel/Assets/favicon.ico" ToolTipText="InfoPanel">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open InfoPanel" Click="TrayMenu_Open" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Click="TrayMenu_Exit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

</Application>
