<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:InfoPanel.Models"
             x:Class="InfoPanel.Views.Pages.DashboardPage"
             x:DataType="models:Profile">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="16">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your profiles and where they are shown."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ItemsControl x:Name="ProfileList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Profile">
                        <Border Width="260" Margin="0,0,16,16" Padding="16"
                                CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding Width}" /><Run Text="×" /><Run Text="{Binding Height}" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Show overlay" Click="ShowOverlay_Click" Tag="{Binding}" />
                                    <Button Content="Hide" Click="HideOverlay_Click" Tag="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>

</UserControl>
