<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:designer="using:InfoPanel.Designer"
             xmlns:models="using:InfoPanel.Models"
             xmlns:vm="using:InfoPanel.ViewModels"
             x:Class="InfoPanel.Views.Pages.DesignerPage">

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="ProfilePicker" MinWidth="160" SelectionChanged="ProfilePicker_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Profile">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ToggleSwitch x:Name="ActiveToggle" OnContent="Active" OffContent="Active"
                              IsCheckedChanged="ActiveToggle_Changed" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Content="+ Add ▾">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Text" Click="AddText_Click" />
                            <MenuItem Header="Sensor" Click="AddSensor_Click" />
                            <MenuItem Header="Clock" Click="AddClock_Click" />
                            <MenuItem Header="Calendar" Click="AddCalendar_Click" />
                            <MenuItem Header="Bar" Click="AddSensorAsBar_Click" />
                            <MenuItem Header="Graph" Click="AddSensorAsGraph_Click" />
                            <MenuItem Header="Donut" Click="AddSensorAsDonut_Click" />
                            <MenuItem Header="Gauge" Click="AddSensorAsGauge_Click" />
                            <MenuItem Header="Sensor image" Click="AddSensorAsImage_Click" />
                            <Separator />
                            <MenuItem Header="Image…" Click="AddImage_Click" />
                            <MenuItem Header="Shape" Click="AddShape_Click" />
                            <MenuItem Header="Group" Click="AddGroup_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="UndoButton" Content="&#x21B6;" ToolTip.Tip="Undo (Ctrl+Z)" Click="Undo_Click" IsEnabled="False" />
                <Button x:Name="RedoButton" Content="&#x21B7;" ToolTip.Tip="Redo (Ctrl+Y)" Click="Redo_Click" IsEnabled="False" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton x:Name="SnapToggle" Content="Snap" IsChecked="True" Click="Snap_Click" />
                <Button Content="Fit" Click="Fit_Click" />
                <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Text="100%"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" MinWidth="44" />
                <Separator Width="1" Height="24" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button Content="Save" Click="Save_Click" />
                <Button Content="Reload" Click="Reload_Click" ToolTip.Tip="Discard unsaved changes and reload from disk" />
                <Button Content="Restore" Click="Restore_Click" ToolTip.Tip="Roll back to the layout from before this editing session" />
                <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="270,4,*,4,300">

            <!-- Left: layers + sensors -->
            <TabControl Grid.Column="0">
                <TabItem Header="Layers">
                    <DockPanel>
                        <TextBox x:Name="LayerSearch" DockPanel.Dock="Top" PlaceholderText="Filter items…"
                                 Margin="4" TextChanged="LayerSearch_TextChanged" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="4" Spacing="0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Del" FontSize="11" Margin="0,0,4,4" Click="LayerDelete_Click" ToolTip.Tip="Delete selected" />
                                <Button Content="Dup" FontSize="11" Margin="0,0,4,4" Click="LayerDuplicate_Click" ToolTip.Tip="Duplicate selected" />
                                <Button Content="↑" FontSize="11" Margin="0,0,4,4" Click="LayerUp_Click" ToolTip.Tip="Move up (bring forward)" />
                                <Button Content="↓" FontSize="11" Margin="0,0,4,4" Click="LayerDown_Click" ToolTip.Tip="Move down (send backward)" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Top" FontSize="11" Margin="0,0,4,4" Click="LayerTop_Click" ToolTip.Tip="Bring to front" />
                                <Button Content="Bottom" FontSize="11" Margin="0,0,4,4" Click="LayerBottom_Click" ToolTip.Tip="Send to back" />
                            </StackPanel>
                        </StackPanel>
                        <TreeView x:Name="LayersTree" SelectionChanged="LayersTree_SelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="models:DisplayItem">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="H" FontSize="10" Opacity="0.6" IsVisible="{Binding Hidden}" VerticalAlignment="Center" />
                                            <TextBlock Text="L" FontSize="10" Opacity="0.6" IsVisible="{Binding IsLocked}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Kind}" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                            <TextBlock FontSize="10" Opacity="0.55" VerticalAlignment="Center">
                                                <Run Text="(" /><Run Text="{Binding X}" /><Run Text="," /><Run Text="{Binding Y}" /><Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Sensors">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="4">
                            <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="Refresh sensors" Click="RefreshSensors_Click" Margin="4,0,0,0" />
                            <TextBox x:Name="SensorSearch" PlaceholderText="Search sensors…" TextChanged="SensorSearch_TextChanged" />
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="4" Spacing="4">
                            <TextBlock Text="Add selected sensor as:" FontSize="11" Opacity="0.7" />
                            <WrapPanel>
                                <Button Content="Text" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsText_Click" />
                                <Button Content="Bar" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsBar_Click" />
                                <Button Content="Graph" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsGraph_Click" />
                                <Button Content="Donut" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsDonut_Click" />
                                <Button Content="Gauge" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsGauge_Click" />
                                <Button Content="Image" FontSize="11" Margin="0,0,4,4" Click="AddSensorAsImage_Click" />
                            </WrapPanel>
                            <Button Content="Replace on selected item" FontSize="11" Click="ReplaceSensor_Click"
                                    ToolTip.Tip="Bind this sensor to the item selected on the canvas" />
                        </StackPanel>
                        <TreeView x:Name="SensorTree" DoubleTapped="SensorTree_DoubleTapped"
                                  Tapped="SensorTree_Tapped"
                                  SelectionChanged="SensorTree_SelectionChanged">
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:SensorTreeItem" ItemsSource="{Binding Children}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayValue}"
                                                   FontSize="11" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                <designer:DesignCanvas x:Name="Canvas" />
                <ScrollBar x:Name="CanvasVScroll" Grid.Column="1" Orientation="Vertical"
                           AllowAutoHide="False" IsVisible="False" />
                <ScrollBar x:Name="CanvasHScroll" Grid.Row="1" Orientation="Horizontal"
                           AllowAutoHide="False" IsVisible="False" />
            </Grid>

            <GridSplitter Grid.Column="3" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

            <!-- Right: inspector -->
            <designer:InspectorPanel x:Name="Inspector" Grid.Column="4" />

        </Grid>

    </DockPanel>

</UserControl>
