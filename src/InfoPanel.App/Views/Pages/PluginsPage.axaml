<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InfoPanel.ViewModels"
             x:Class="InfoPanel.Views.Pages.PluginsPage"
             x:DataType="vm:PluginsPageViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="ConfigEntryTemplate" x:DataType="vm:PluginConfigEntryViewModel">
            <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" MaxWidth="220" Margin="0,0,10,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                    <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.55"
                               TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                </StackPanel>
                <Panel>
                    <TextBox IsVisible="{Binding IsString}" Text="{Binding StringValue, Mode=TwoWay}"
                             FontSize="12" MinWidth="140" HorizontalAlignment="Right" />
                    <NumericUpDown IsVisible="{Binding IsNumeric}" Value="{Binding NumberValue, Mode=TwoWay}"
                                   Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                   Increment="{Binding Increment}" FormatString="{Binding NumberFormat}"
                                   FontSize="12" MinWidth="140" HorizontalAlignment="Right" />
                    <ToggleSwitch IsVisible="{Binding IsBoolean}" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                  OnContent="" OffContent="" MinWidth="0" HorizontalAlignment="Right" />
                    <ComboBox IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}"
                              SelectedItem="{Binding ChoiceValue, Mode=TwoWay}"
                              FontSize="12" MinWidth="140" HorizontalAlignment="Right" />
                </Panel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ModuleRowTemplate" x:DataType="vm:PluginModuleViewModel">
            <DockPanel Margin="0,2,0,0">
                <Button DockPanel.Dock="Right" Content="Reload" FontSize="10" Padding="6,2"
                        Command="{Binding ReloadCommand}" />
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" Margin="0,0,6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PluginActionCommand">
                            <Button Content="{Binding DisplayName}" FontSize="10" Padding="6,2"
                                    Command="{Binding Command}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Name}" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- Modules with a config panel get their own tile with the editors inline -->
        <DataTemplate x:Key="ConfigurableModuleTileTemplate" x:DataType="vm:PluginModuleViewModel">
            <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reload" FontSize="10" Padding="6,2"
                                Command="{Binding ReloadCommand}" />
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Actions}" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginActionCommand">
                                    <Button Content="{Binding DisplayName}" FontSize="10" Padding="6,2"
                                            Command="{Binding Command}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    <Separator Margin="0,2" Opacity="0.3" />
                    <ItemsControl ItemsSource="{Binding ConfigEntries}"
                                  ItemTemplate="{StaticResource ConfigEntryTemplate}" />
                    <TextBlock Text="Changes apply and save automatically." FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginCardTemplate" x:DataType="vm:PluginViewModel">
            <StackPanel>
                <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <DockPanel>
                            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Activated, Mode=TwoWay}"
                                          IsEnabled="{Binding ControlEnabled}" OnContent="" OffContent="" MinWidth="0" />
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Opacity="0.6">
                                    <Run Text="{Binding Version}" /> · <Run Text="{Binding Author}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SimpleModules}"
                                      ItemTemplate="{StaticResource ModuleRowTemplate}" />
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding ConfigurableModules}"
                              ItemTemplate="{StaticResource ConfigurableModuleTileTemplate}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Add plugin…" Command="{Binding AddPluginFromZipCommand}" />
                <StackPanel Spacing="4">
                    <TextBlock Text="Plugins" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Manage plugin packages and their configuration."
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding PluginFolder}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
            <Border IsVisible="{Binding ShowRestartBanner}" Background="#33FFA500" CornerRadius="4" Padding="8,4">
                <TextBlock Text="Restart InfoPanel to load the new plugin." FontSize="12" />
            </Border>
        </StackPanel>
        <ScrollViewer>
            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="Bundled" FontSize="13" FontWeight="SemiBold" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding BundledPlugins}" ItemTemplate="{StaticResource PluginCardTemplate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="External" FontSize="13" FontWeight="SemiBold" Opacity="0.8" />
                    <ItemsControl ItemsSource="{Binding ExternalPlugins}" ItemTemplate="{StaticResource PluginCardTemplate}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>

</UserControl>
