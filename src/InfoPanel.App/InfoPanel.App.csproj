<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InfoPanel</RootNamespace>
    <AssemblyName>infopanel</AssemblyName>
    <Version>0.0.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.0.2" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoPanel.Core\InfoPanel.Core.csproj" />
    <ProjectReference Include="..\InfoPanel.Devices\InfoPanel.Devices.csproj" />
    <ProjectReference Include="..\InfoPanel.Devices.BeadaPanel\InfoPanel.Devices.BeadaPanel.csproj" />
    <ProjectReference Include="..\InfoPanel.Devices.Thermalright\InfoPanel.Devices.Thermalright.csproj" />
    <ProjectReference Include="..\InfoPanel.Devices.TuringPanel\InfoPanel.Devices.TuringPanel.csproj" />
    <ProjectReference Include="..\InfoPanel.Platform.Linux\InfoPanel.Platform.Linux.csproj" />
    <ProjectReference Include="..\InfoPanel.Rendering\InfoPanel.Rendering.csproj" />
    <ProjectReference Include="..\InfoPanel.Sensors\InfoPanel.Sensors.csproj" />
    <ProjectReference Include="..\InfoPanel.Web\InfoPanel.Web.csproj" />
    <ProjectReference Include="..\InfoPanel.Sensors.Linux\InfoPanel.Sensors.Linux.csproj" />
  </ItemGroup>

  <!-- Build InfoPanel.Extras (net8.0 plugin) and ship it under plugins/InfoPanel.Extras,
       replicating v1's layout: the plugin folder deliberately excludes InfoPanel.Plugins.dll
       so the contract assembly resolves from the host (shared type identity). -->
  <Target Name="BuildExtras" BeforeTargets="Build">
    <MSBuild Projects="..\InfoPanel.Extras\InfoPanel.Extras.csproj" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net8.0;SelfContained=false" RemoveProperties="RuntimeIdentifier;PublishDir;SelfContained" />
    <MSBuild Projects="..\InfoPanel.Extras\InfoPanel.Extras.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration);TargetFramework=net8.0" RemoveProperties="RuntimeIdentifier;PublishDir;SelfContained">
      <Output TaskParameter="TargetOutputs" PropertyName="_ExtrasAssemblyPath" />
    </MSBuild>
    <PropertyGroup>
      <ExtrasOutputDir>$([System.IO.Path]::GetDirectoryName('$(_ExtrasAssemblyPath)'))</ExtrasOutputDir>
    </PropertyGroup>
  </Target>

  <Target Name="CopyExtrasToBuildOutput" AfterTargets="BuildExtras">
    <ItemGroup>
      <ExtrasFiles Include="$(ExtrasOutputDir)\**\*.*" Exclude="$(ExtrasOutputDir)\InfoPanel.Plugins.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtrasFiles)" DestinationFolder="$(OutputPath)plugins/InfoPanel.Extras" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyExtrasToPublishOutput" AfterTargets="Publish">
    <ItemGroup>
      <ExtrasPublishFiles Include="$(ExtrasOutputDir)\**\*.*" Exclude="$(ExtrasOutputDir)\InfoPanel.Plugins.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ExtrasPublishFiles)" DestinationFolder="$(PublishDir)plugins/InfoPanel.Extras" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CleanPluginsDirectory" BeforeTargets="Clean">
    <RemoveDir Directories="$(OutputPath)plugins" />
  </Target>

</Project>
